# Dependencies（平台相关，pnpm install 可再生，且含 >100MB 二进制无法进 Git）
node_modules/
.pnp
.pnp.js

# 构建产物与打包运行时（pnpm build 可再生）
dist/
dist-*/
build/
out/
.next/
.nuxt/
.turbo/
coverage/

# 超限安装产物（>100MB，超出 GitHub 限制，他人安装安装包后自动生成）
release/win-unpacked/

# 历史发布备份（41 个目录，纯历史快照，无共享价值）
release-bak-*/
backups/

# Source maps（体积大，可再生产物）
*.map

# 敏感文件（禁止上传）
*.pem
*.key
*.p12
*.pfx
.env
.env.*
!.env.example
secrets/
credentials.json
runtime-token

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 缓存
.cache/
.temp/

# CodeBuddy
.codebuddy/
